using UnityEngine;

public class Enemy : Entity
{
    public Enemy_IdleState idleState;
    public Enemy_MoveState moveState;
    public Enemy_AttackState attackState;
    public Enemy_BattleState battleState;

    [Header("Battle Details")]
    public float battleMoveSpeed = 3;
    public float attackDistance = 2;
    public float battleTimeDuration = 5;
    public float minimumRetreatDistance = 1;
    public Vector2 retreatVelocity;

    [Header("Movement Details")]
    public float idleTime = 2;
    public float moveSpeed = 1.4f;
    [Range(0,2)]
    public float moveAnimSpeedMultiplier = 1;

    [Header("Player Detection")]
    [SerializeField] private LayerMask whatIsPlayer;
    [SerializeField] private Transform playerCheck;
    [SerializeField] private float playerCheckDistance = 10;
    [SerializeField] private Transform backCheck;
    [SerializeField] private float backCheckDistance = 2f;
    [SerializeField] private Transform backGroundCheck;
    [SerializeField] private float backGroundCheckDistance = 1f;

    public RaycastHit2D PlayerDetection()
    {
        // Forward check
        RaycastHit2D hit = Physics2D.Raycast(playerCheck.position, Vector2.right * facingDirection, playerCheckDistance, whatIsPlayer | whatIsGround);
        if (hit.collider != null && hit.collider.gameObject.layer == LayerMask.NameToLayer("Player"))
        {
            return hit;
        }

    public bool GroundDetectedBack()
    {
        if (backGroundCheck == null)
            return true; // assume ground if no check provided

        return Physics2D.Raycast(backGroundCheck.position, Vector2.down, backGroundCheckDistance, whatIsGround);
    }

        // Backward (short) check
        Vector3 backOrigin = backCheck != null ? backCheck.position : playerCheck.position;
        RaycastHit2D backHit = Physics2D.Raycast(backOrigin, Vector2.right * -facingDirection, backCheckDistance, whatIsPlayer | whatIsGround);
        if (backHit.collider != null && backHit.collider.gameObject.layer == LayerMask.NameToLayer("Player"))
        {
            return backHit;
        }

        return default;
    }

    public RaycastHit2D PlayerDetectionBack()
    {
        Vector3 origin = backCheck != null ? backCheck.position : playerCheck.position;
        RaycastHit2D hit = Physics2D.Raycast(origin, Vector2.right * -facingDirection, backCheckDistance, whatIsPlayer | whatIsGround);

        if (hit.collider == null || hit.collider.gameObject.layer != LayerMask.NameToLayer("Player"))
        {
            return default;
        }

        return hit;
    }

    protected override void OnDrawGizmos()
    {
        base.OnDrawGizmos();
        
        Gizmos.color = Color.yellow;
        Gizmos.DrawLine(playerCheck.position, new Vector3(playerCheck.position.x + (facingDirection * playerCheckDistance), playerCheck.position.y));
        Gizmos.color = Color.blue;
        Gizmos.DrawLine(playerCheck.position, new Vector3(playerCheck.position.x + (facingDirection * attackDistance), playerCheck.position.y));
        Gizmos.color = Color.green;
        Gizmos.DrawLine(playerCheck.position, new Vector3(playerCheck.position.x + (facingDirection * minimumRetreatDistance), playerCheck.position.y));
        Gizmos.color = Color.magenta;
        Vector3 backOrigin = backCheck != null ? backCheck.position : playerCheck.position;
        Gizmos.DrawLine(backOrigin, new Vector3(backOrigin.x + (-facingDirection * backCheckDistance), backOrigin.y));

        if (backGroundCheck != null)
        {
            Gizmos.color = Color.cyan;
            Gizmos.DrawLine(backGroundCheck.position, backGroundCheck.position + new Vector3(0, -backGroundCheckDistance, 0));
        }
    }
}
